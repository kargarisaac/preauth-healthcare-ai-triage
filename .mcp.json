{
  "name": "preauth-tools",
  "description": "MCP server for pre-authorization healthcare policy tools",
  "version": "1.0.0",
  "server": {
    "command": "python",
    "args": ["-m", "preauth_system.tools.mcp_server"],
    "env": {
      "PYTHONPATH": "."
    }
  },
  "tools": [
    {
      "name": "search_healthcare_policies",
      "description": "Search healthcare policy knowledge base for relevant evidence",
      "schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Clinical question or search terms"
          },
          "top_k": {
            "type": "integer",
            "description": "Maximum results to return (1-10)",
            "default": 5
          },
          "policy_filter": {
            "type": "string",
            "description": "Filter by policy type",
            "enum": ["diabetes_tech", "osteoarthritis", "parkinson_dbs"]
          }
        },
        "required": ["query"]
      }
    },
    {
      "name": "get_policy_information", 
      "description": "Get comprehensive overview of a specific healthcare policy",
      "schema": {
        "type": "object",
        "properties": {
          "policy_type": {
            "type": "string",
            "description": "Policy type",
            "enum": ["diabetes_tech", "osteoarthritis", "parkinson_dbs"]
          }
        },
        "required": ["policy_type"]
      }
    },
    {
      "name": "validate_evidence_citation",
      "description": "Validate and get detailed citation information for evidence", 
      "schema": {
        "type": "object",
        "properties": {
          "snippet_id": {
            "type": "string",
            "description": "ID of the evidence snippet to validate"
          }
        },
        "required": ["snippet_id"]
      }
    }
  ]
}