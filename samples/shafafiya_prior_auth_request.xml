<?xml version="1.0" encoding="UTF-8"?>
<Prior.Authorization
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../schemas/PriorAuthorization.xsd">

  <!-- Header section -->
  <Header>
    <SenderID>PROV12345</SenderID>
    <ReceiverID>PAYER67890</ReceiverID>
    <!-- dd/mm/yyyy HH:MM format as required by HeaderTransactionDate type -->
    <TransactionDate>27/07/2025 10:32</TransactionDate>
    <RecordCount>1</RecordCount>
    <DispositionFlag>TEST</DispositionFlag>
  </Header>

  <!-- Authorization section -->
  <Authorization>
    <Result>Yes</Result>
    <!-- Unique authorization identifier -->
    <ID>PA-2025-000123</ID>
    <!-- Start & End in dd/mm/yyyy HH:MM format -->
    <Start>25/07/2025 00:00</Start>
    <End>25/07/2025 00:00</End>
    <!-- Human-readable comments / justification -->
    <Comments>Patient with poorly controlled diabetes; last HbA1c 9 months ago. No retinopathy screen in 18 months.</Comments>

    <!-- First activity -->
    <Activity>
      <ID>1</ID>
      <!-- 3 = CPT as per ActivityType enumeration -->
      <Type>3</Type>
      <Code>83036</Code>
      <Quantity>1</Quantity>
      <Net>120.00</Net>
      <PaymentAmount>0.00</PaymentAmount>
    </Activity>

    <!-- Second activity -->
    <Activity>
      <ID>2</ID>
      <Type>3</Type>
      <Code>92014</Code>
      <Quantity>1</Quantity>
      <Net>250.00</Net>
      <PaymentAmount>0.00</PaymentAmount>
    </Activity>
  </Authorization>

</Prior.Authorization>
