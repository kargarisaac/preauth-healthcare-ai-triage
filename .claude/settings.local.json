{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(source:*)",
      "Bash(PYTHONPATH=. python:*)",
      "Bash(curl:*)",
      "Bash(uv run:*)",
      "Bash(ls:*)",
      "Bash(pkill:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm install)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run type-check:*)",
      "Bash(touch:*)",
      "mcp__baml-docs__fetch_docs",
      "mcp__baml-docs__list_doc_sources",
      "Bash(find:*)",
      "Bash(npx tsc:*)",
      "Bash(uv add:*)",
      "Bash(ruff check:*)",
      "Bash(npm run test:coverage:*)",
      "Bash(grep:*)",
      "Bash(for file in *.tsx)",
      "Bash(do)",
      "Bash(if ! grep -q \"export default\" \"$file\")",
      "Bash(then)",
      "Bash(echo:*)",
      "Bash(fi)",
      "Bash(done)",
      "Bash(chmod:*)"
    ],
    "deny": []
  }
}