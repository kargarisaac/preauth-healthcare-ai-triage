{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(source:*)",
      "Bash(PYTHONPATH=. python:*)",
      "Bash(curl:*)",
      "Bash(uv run:*)",
      "Bash(ls:*)",
      "Bash(pkill:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm install)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run type-check:*)",
      "Bash(touch:*)"
    ],
    "deny": []
  }
}
