{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🤖 Debug Orchestrator Only", 
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/preauth_system/orchestrator.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ENVIRONMENT": "development"
            },
            "args": ["--demo"],
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "🚀 Debug FastAPI Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/api/run_server.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ENVIRONMENT": "development",
                "PORT": "8000"
            },
            "python": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}
