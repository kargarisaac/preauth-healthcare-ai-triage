import React, { useState, useRef, useEffect } from 'react';\nimport { usePerformance } from '@contexts/PerformanceContext';\nimport { trackUserInteraction } from '@utils/performance';\n\n// Enhanced button with micro-interactions\ninterface AnimatedButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {\n  variant?: 'primary' | 'secondary' | 'success' | 'warning' | 'error';\n  size?: 'sm' | 'md' | 'lg';\n  loading?: boolean;\n  icon?: React.ReactNode;\n  hapticFeedback?: boolean;\n  rippleEffect?: boolean;\n  soundFeedback?: boolean;\n}\n\nexport const AnimatedButton: React.FC<AnimatedButtonProps> = React.memo(({\n  children,\n  variant = 'primary',\n  size = 'md',\n  loading = false,\n  icon,\n  hapticFeedback = true,\n  rippleEffect = true,\n  soundFeedback = false,\n  className = '',\n  onClick,\n  disabled,\n  ...props\n}) => {\n  const [isPressed, setIsPressed] = useState(false);\n  const [ripples, setRipples] = useState<Array<{ id: number; x: number; y: number }>>([]);\n  const buttonRef = useRef<HTMLButtonElement>(null);\n  const { prefersReducedMotion } = usePerformance();\n  const rippleId = useRef(0);\n\n  const variants = {\n    primary: 'bg-blue-600 hover:bg-blue-700 text-white',\n    secondary: 'bg-gray-200 hover:bg-gray-300 text-gray-900',\n    success: 'bg-green-600 hover:bg-green-700 text-white',\n    warning: 'bg-yellow-500 hover:bg-yellow-600 text-white',\n    error: 'bg-red-600 hover:bg-red-700 text-white',\n  };\n\n  const sizes = {\n    sm: 'px-3 py-1.5 text-sm',\n    md: 'px-4 py-2 text-base',\n    lg: 'px-6 py-3 text-lg',\n  };\n\n  const handleClick = (e: React.MouseEvent<HTMLButtonElement>) => {\n    if (disabled || loading) return;\n\n    // Haptic feedback (if supported)\n    if (hapticFeedback && 'vibrate' in navigator && !prefersReducedMotion) {\n      navigator.vibrate(10);\n    }\n\n    // Sound feedback\n    if (soundFeedback && !prefersReducedMotion) {\n      const audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();\n      const oscillator = audioContext.createOscillator();\n      const gainNode = audioContext.createGain();\n      \n      oscillator.connect(gainNode);\n      gainNode.connect(audioContext.destination);\n      \n      oscillator.frequency.setValueAtTime(800, audioContext.currentTime);\n      gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);\n      gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);\n      \n      oscillator.start();\n      oscillator.stop(audioContext.currentTime + 0.1);\n    }\n\n    // Ripple effect\n    if (rippleEffect && !prefersReducedMotion && buttonRef.current) {\n      const rect = buttonRef.current.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      \n      const newRipple = { id: rippleId.current++, x, y };\n      setRipples(prev => [...prev, newRipple]);\n      \n      setTimeout(() => {\n        setRipples(prev => prev.filter(ripple => ripple.id !== newRipple.id));\n      }, 600);\n    }\n\n    // Track interaction\n    trackUserInteraction('button_click', 'AnimatedButton', {\n      variant,\n      size,\n      hasIcon: !!icon,\n      hasRipple: rippleEffect,\n    });\n\n    onClick?.(e);\n  };\n\n  const buttonClasses = `\n    relative overflow-hidden\n    ${variants[variant]}\n    ${sizes[size]}\n    ${disabled || loading ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}\n    ${!prefersReducedMotion ? 'transition-all duration-200 ease-in-out' : ''}\n    ${isPressed && !prefersReducedMotion ? 'scale-95' : ''}\n    ${!disabled && !loading ? 'hover:shadow-lg transform hover:-translate-y-0.5' : ''}\n    rounded-lg font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500\n    ${className}\n  `.trim();\n\n  return (\n    <button\n      ref={buttonRef}\n      className={buttonClasses}\n      onClick={handleClick}\n      onMouseDown={() => !prefersReducedMotion && setIsPressed(true)}\n      onMouseUp={() => setIsPressed(false)}\n      onMouseLeave={() => setIsPressed(false)}\n      disabled={disabled || loading}\n      {...props}\n    >\n      {/* Ripple effects */}\n      {rippleEffect && !prefersReducedMotion && (\n        <div className=\"absolute inset-0 pointer-events-none\">\n          {ripples.map(ripple => (\n            <div\n              key={ripple.id}\n              className=\"absolute bg-white bg-opacity-25 rounded-full animate-ping\"\n              style={{\n                left: ripple.x - 8,\n                top: ripple.y - 8,\n                width: 16,\n                height: 16,\n                animationDuration: '0.6s',\n              }}\n            />\n          ))}\n        </div>\n      )}\n\n      {/* Button content */}\n      <div className=\"relative flex items-center justify-center gap-2\">\n        {loading ? (\n          <div className=\"w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin\" />\n        ) : (\n          icon && <span className=\"inline-flex\">{icon}</span>\n        )}\n        {children}\n      </div>\n    </button>\n  );\n});\n\nAnimatedButton.displayName = 'AnimatedButton';\n\n// Floating Action Button with advanced animations\ninterface FloatingActionButtonProps {\n  icon: React.ReactNode;\n  onClick: () => void;\n  position?: 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left';\n  className?: string;\n  tooltip?: string;\n  expandable?: boolean;\n  actions?: Array<{ icon: React.ReactNode; label: string; onClick: () => void }>;\n}\n\nexport const FloatingActionButton: React.FC<FloatingActionButtonProps> = React.memo(({\n  icon,\n  onClick,\n  position = 'bottom-right',\n  className = '',\n  tooltip,\n  expandable = false,\n  actions = [],\n}) => {\n  const [isExpanded, setIsExpanded] = useState(false);\n  const [showTooltip, setShowTooltip] = useState(false);\n  const { prefersReducedMotion } = usePerformance();\n\n  const positions = {\n    'bottom-right': 'bottom-6 right-6',\n    'bottom-left': 'bottom-6 left-6',\n    'top-right': 'top-6 right-6',\n    'top-left': 'top-6 left-6',\n  };\n\n  const handleMainAction = () => {\n    if (expandable && actions.length > 0) {\n      setIsExpanded(!isExpanded);\n      trackUserInteraction('fab_expand', 'FloatingActionButton', { isExpanded: !isExpanded });\n    } else {\n      onClick();\n      trackUserInteraction('fab_click', 'FloatingActionButton');\n    }\n  };\n\n  const handleActionClick = (action: typeof actions[0], index: number) => {\n    action.onClick();\n    setIsExpanded(false);\n    trackUserInteraction('fab_action_click', 'FloatingActionButton', { actionIndex: index });\n  };\n\n  return (\n    <div className={`fixed ${positions[position]} z-50 ${className}`}>\n      {/* Action buttons (when expanded) */}\n      {expandable && isExpanded && (\n        <div className=\"absolute bottom-16 right-0 space-y-3\">\n          {actions.map((action, index) => (\n            <div\n              key={index}\n              className={`\n                flex items-center justify-end group\n                ${!prefersReducedMotion ? 'animate-in slide-in-from-bottom-2 duration-300' : ''}\n              `}\n              style={{\n                animationDelay: !prefersReducedMotion ? `${index * 50}ms` : '0ms',\n              }}\n            >\n              {/* Action label */}\n              <div className=\"mr-3 px-3 py-1 bg-black bg-opacity-75 text-white text-sm rounded whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity\">\n                {action.label}\n              </div>\n              \n              {/* Action button */}\n              <button\n                onClick={() => handleActionClick(action, index)}\n                className={`\n                  w-12 h-12 bg-white shadow-lg rounded-full flex items-center justify-center\n                  hover:shadow-xl hover:scale-110 active:scale-95\n                  ${!prefersReducedMotion ? 'transition-all duration-200' : ''}\n                  focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2\n                `}\n              >\n                {action.icon}\n              </button>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Main FAB */}\n      <div className=\"relative\">\n        {/* Tooltip */}\n        {tooltip && showTooltip && (\n          <div className=\"absolute bottom-16 right-0 px-3 py-1 bg-black bg-opacity-75 text-white text-sm rounded whitespace-nowrap\">\n            {tooltip}\n          </div>\n        )}\n\n        <button\n          onClick={handleMainAction}\n          onMouseEnter={() => setShowTooltip(true)}\n          onMouseLeave={() => setShowTooltip(false)}\n          className={`\n            w-16 h-16 bg-blue-600 hover:bg-blue-700 text-white shadow-lg rounded-full\n            flex items-center justify-center group relative\n            hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2\n            ${!prefersReducedMotion ? 'transition-all duration-300 hover:scale-110 active:scale-95' : ''}\n            ${isExpanded && !prefersReducedMotion ? 'rotate-45' : ''}\n          `}\n        >\n          {/* Pulse animation */}\n          {!prefersReducedMotion && (\n            <div className=\"absolute inset-0 rounded-full bg-blue-600 animate-ping opacity-20\" />\n          )}\n          \n          {/* Icon */}\n          <span className=\"relative z-10\">{icon}</span>\n        </button>\n      </div>\n\n      {/* Backdrop (when expanded) */}\n      {isExpanded && (\n        <div\n          className=\"fixed inset-0 -z-10 bg-black bg-opacity-20\"\n          onClick={() => setIsExpanded(false)}\n        />\n      )}\n    </div>\n  );\n});\n\nFloatingActionButton.displayName = 'FloatingActionButton';\n\n// Progress indicator with smooth animations\ninterface AnimatedProgressProps {\n  value: number; // 0-100\n  label?: string;\n  showPercentage?: boolean;\n  color?: string;\n  height?: number;\n  animated?: boolean;\n  className?: string;\n}\n\nexport const AnimatedProgress: React.FC<AnimatedProgressProps> = React.memo(({\n  value,\n  label,\n  showPercentage = true,\n  color = 'bg-blue-600',\n  height = 8,\n  animated = true,\n  className = '',\n}) => {\n  const { prefersReducedMotion } = usePerformance();\n  const [displayValue, setDisplayValue] = useState(0);\n  const animationRef = useRef<number>();\n\n  // Smooth animation for progress value\n  useEffect(() => {\n    if (prefersReducedMotion) {\n      setDisplayValue(value);\n      return;\n    }\n\n    const startValue = displayValue;\n    const endValue = value;\n    const duration = 500; // ms\n    const startTime = Date.now();\n\n    const animate = () => {\n      const elapsed = Date.now() - startTime;\n      const progress = Math.min(elapsed / duration, 1);\n      \n      // Easing function (ease-out)\n      const easeProgress = 1 - Math.pow(1 - progress, 3);\n      const currentValue = startValue + (endValue - startValue) * easeProgress;\n      \n      setDisplayValue(currentValue);\n      \n      if (progress < 1) {\n        animationRef.current = requestAnimationFrame(animate);\n      }\n    };\n\n    animationRef.current = requestAnimationFrame(animate);\n    \n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, [value, displayValue, prefersReducedMotion]);\n\n  return (\n    <div className={`w-full ${className}`}>\n      {/* Label and percentage */}\n      {(label || showPercentage) && (\n        <div className=\"flex justify-between items-center mb-2\">\n          {label && <span className=\"text-sm font-medium text-gray-700\">{label}</span>}\n          {showPercentage && (\n            <span className=\"text-sm text-gray-500\">{Math.round(displayValue)}%</span>\n          )}\n        </div>\n      )}\n      \n      {/* Progress bar */}\n      <div\n        className=\"w-full bg-gray-200 rounded-full overflow-hidden\"\n        style={{ height }}\n      >\n        <div\n          className={`h-full ${color} rounded-full relative overflow-hidden`}\n          style={{\n            width: `${Math.max(0, Math.min(100, displayValue))}%`,\n            transition: prefersReducedMotion ? 'none' : 'width 0.3s ease-out',\n          }}\n        >\n          {/* Animated shine effect */}\n          {animated && !prefersReducedMotion && displayValue > 0 && displayValue < 100 && (\n            <div\n              className=\"absolute inset-0 bg-gradient-to-r from-transparent via-white via-white to-transparent opacity-30\"\n              style={{\n                animation: 'shine 2s infinite',\n                transform: 'translateX(-100%)',\n              }}\n            />\n          )}\n        </div>\n      </div>\n    </div>\n  );\n});\n\nAnimatedProgress.displayName = 'AnimatedProgress';\n\n// CSS for shine animation\nconst shineKeyframes = `\n  @keyframes shine {\n    0% { transform: translateX(-100%); }\n    100% { transform: translateX(100%); }\n  }\n`;\n\n// Inject keyframes into document head\nif (typeof document !== 'undefined') {\n  const style = document.createElement('style');\n  style.textContent = shineKeyframes;\n  document.head.appendChild(style);\n}