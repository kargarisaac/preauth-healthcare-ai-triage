import { useEffect, useCallback, useState, useRef } from 'react';\nimport { trackAnalytics } from '@utils/performance';\n\ninterface AccessibilityOptions {\n  announcePageChanges?: boolean;\n  manageFocus?: boolean;\n  trackKeyboardNavigation?: boolean;\n  announceErrors?: boolean;\n  enableHighContrast?: boolean;\n}\n\ninterface AccessibilityState {\n  isUsingKeyboard: boolean;\n  isUsingScreenReader: boolean;\n  prefersReducedMotion: boolean;\n  highContrastMode: boolean;\n  fontSize: 'normal' | 'large' | 'extra-large';\n  announcements: string[];\n}\n\nexport const useAccessibility = (options: AccessibilityOptions = {}) => {\n  const {\n    announcePageChanges = true,\n    manageFocus = true,\n    trackKeyboardNavigation = true,\n    announceErrors = true,\n    enableHighContrast = false,\n  } = options;\n\n  const [state, setState] = useState<AccessibilityState>({\n    isUsingKeyboard: false,\n    isUsingScreenReader: false,\n    prefersReducedMotion: false,\n    highContrastMode: false,\n    fontSize: 'normal',\n    announcements: [],\n  });\n\n  const announcementTimeoutRef = useRef<NodeJS.Timeout>();\n  const lastFocusableElement = useRef<HTMLElement | null>(null);\n  const focusTrapRef = useRef<HTMLElement | null>(null);\n\n  // Detect screen reader usage\n  useEffect(() => {\n    const detectScreenReader = () => {\n      // Check for common screen reader indicators\n      const hasScreenReaderText = document.querySelector('.sr-only, .screen-reader-text');\n      const hasAriaLive = document.querySelector('[aria-live]');\n      const userAgent = navigator.userAgent.toLowerCase();\n      \n      // Common screen reader user agents\n      const screenReaderIndicators = [\n        'jaws', 'nvda', 'voiceover', 'talkback', 'orca', 'narrator'\n      ];\n      \n      const hasScreenReaderUA = screenReaderIndicators.some(sr => userAgent.includes(sr));\n      \n      const isScreenReader = !!(hasScreenReaderText || hasAriaLive || hasScreenReaderUA);\n      \n      setState(prev => ({ ...prev, isUsingScreenReader: isScreenReader }));\n      \n      if (isScreenReader) {\n        trackAnalytics({\n          name: 'screen_reader_detected',\n          category: 'accessibility',\n          data: { userAgent }\n        });\n      }\n    };\n\n    detectScreenReader();\n  }, []);\n\n  // Detect keyboard navigation\n  useEffect(() => {\n    if (!trackKeyboardNavigation) return;\n\n    let isTabPressed = false;\n    let mouseUsed = false;\n\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === 'Tab') {\n        isTabPressed = true;\n        if (!mouseUsed) {\n          setState(prev => ({ ...prev, isUsingKeyboard: true }));\n        }\n        \n        trackAnalytics({\n          name: 'keyboard_navigation',\n          category: 'accessibility',\n          data: {\n            key: e.key,\n            shiftKey: e.shiftKey,\n            target: (e.target as HTMLElement)?.tagName || 'unknown'\n          }\n        });\n      }\n      \n      // Escape key handling for modals/overlays\n      if (e.key === 'Escape') {\n        trackAnalytics({\n          name: 'escape_key_pressed',\n          category: 'accessibility',\n        });\n      }\n    };\n\n    const handleMouseDown = () => {\n      mouseUsed = true;\n      if (isTabPressed) {\n        setState(prev => ({ ...prev, isUsingKeyboard: false }));\n      }\n    };\n\n    document.addEventListener('keydown', handleKeyDown);\n    document.addEventListener('mousedown', handleMouseDown);\n\n    return () => {\n      document.removeEventListener('keydown', handleKeyDown);\n      document.removeEventListener('mousedown', handleMouseDown);\n    };\n  }, [trackKeyboardNavigation]);\n\n  // Detect user preferences\n  useEffect(() => {\n    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const prefersHighContrast = window.matchMedia('(prefers-contrast: high)').matches;\n    \n    setState(prev => ({\n      ...prev,\n      prefersReducedMotion,\n      highContrastMode: prefersHighContrast || enableHighContrast\n    }));\n\n    // Listen for changes\n    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n    const contrastQuery = window.matchMedia('(prefers-contrast: high)');\n    \n    const handleMotionChange = (e: MediaQueryListEvent) => {\n      setState(prev => ({ ...prev, prefersReducedMotion: e.matches }));\n    };\n    \n    const handleContrastChange = (e: MediaQueryListEvent) => {\n      setState(prev => ({ ...prev, highContrastMode: e.matches || enableHighContrast }));\n    };\n\n    motionQuery.addEventListener('change', handleMotionChange);\n    contrastQuery.addEventListener('change', handleContrastChange);\n\n    return () => {\n      motionQuery.removeEventListener('change', handleMotionChange);\n      contrastQuery.removeEventListener('change', handleContrastChange);\n    };\n  }, [enableHighContrast]);\n\n  // Screen reader announcements\n  const announce = useCallback((message: string, priority: 'polite' | 'assertive' = 'polite') => {\n    if (!announceErrors && !announcePageChanges) return;\n\n    // Clear existing timeout\n    if (announcementTimeoutRef.current) {\n      clearTimeout(announcementTimeoutRef.current);\n    }\n\n    // Create or update aria-live region\n    let liveRegion = document.getElementById('a11y-announcer');\n    if (!liveRegion) {\n      liveRegion = document.createElement('div');\n      liveRegion.id = 'a11y-announcer';\n      liveRegion.setAttribute('aria-live', priority);\n      liveRegion.setAttribute('aria-atomic', 'true');\n      liveRegion.className = 'sr-only absolute -left-[10000px] w-1 h-1 overflow-hidden';\n      document.body.appendChild(liveRegion);\n    }\n\n    // Update the live region\n    liveRegion.textContent = message;\n    \n    // Track announcement\n    setState(prev => ({\n      ...prev,\n      announcements: [...prev.announcements.slice(-9), message] // Keep last 10\n    }));\n\n    trackAnalytics({\n      name: 'accessibility_announcement',\n      category: 'accessibility',\n      data: {\n        message: message.substring(0, 100), // Truncate for privacy\n        priority,\n        length: message.length\n      }\n    });\n\n    // Clear after 1 second to avoid confusion\n    announcementTimeoutRef.current = setTimeout(() => {\n      if (liveRegion) {\n        liveRegion.textContent = '';\n      }\n    }, 1000);\n  }, [announceErrors, announcePageChanges]);\n\n  // Focus management\n  const manageFocusOnRouteChange = useCallback((newRoute: string) => {\n    if (!manageFocus) return;\n\n    // Announce page change\n    if (announcePageChanges) {\n      const pageTitle = document.title;\n      announce(`Navigated to ${pageTitle}`, 'assertive');\n    }\n\n    // Focus management\n    requestAnimationFrame(() => {\n      // Try to focus on main heading\n      const mainHeading = document.querySelector('h1, [role=\"heading\"][aria-level=\"1\"]') as HTMLElement;\n      if (mainHeading) {\n        mainHeading.focus();\n        return;\n      }\n\n      // Fall back to main content\n      const mainContent = document.querySelector('main, [role=\"main\"]') as HTMLElement;\n      if (mainContent) {\n        mainContent.focus();\n        return;\n      }\n\n      // Last resort: focus on body\n      document.body.focus();\n    });\n\n    trackAnalytics({\n      name: 'focus_managed_route_change',\n      category: 'accessibility',\n      data: { newRoute }\n    });\n  }, [manageFocus, announcePageChanges, announce]);\n\n  // Focus trap for modals\n  const createFocusTrap = useCallback((container: HTMLElement) => {\n    if (!container) return () => {};\n\n    focusTrapRef.current = container;\n    lastFocusableElement.current = document.activeElement as HTMLElement;\n\n    const focusableElements = container.querySelectorAll(\n      'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n    ) as NodeListOf<HTMLElement>;\n\n    const firstFocusable = focusableElements[0];\n    const lastFocusable = focusableElements[focusableElements.length - 1];\n\n    const handleTabKey = (e: KeyboardEvent) => {\n      if (e.key !== 'Tab') return;\n\n      if (e.shiftKey) {\n        if (document.activeElement === firstFocusable) {\n          lastFocusable?.focus();\n          e.preventDefault();\n        }\n      } else {\n        if (document.activeElement === lastFocusable) {\n          firstFocusable?.focus();\n          e.preventDefault();\n        }\n      }\n    };\n\n    container.addEventListener('keydown', handleTabKey);\n    firstFocusable?.focus();\n\n    trackAnalytics({\n      name: 'focus_trap_created',\n      category: 'accessibility',\n      data: {\n        focusableCount: focusableElements.length\n      }\n    });\n\n    // Return cleanup function\n    return () => {\n      container.removeEventListener('keydown', handleTabKey);\n      lastFocusableElement.current?.focus();\n      focusTrapRef.current = null;\n    };\n  }, []);\n\n  // Font size management\n  const setFontSize = useCallback((size: AccessibilityState['fontSize']) => {\n    setState(prev => ({ ...prev, fontSize: size }));\n    \n    const htmlElement = document.documentElement;\n    const sizeMap = {\n      normal: '16px',\n      large: '18px',\n      'extra-large': '20px'\n    };\n    \n    htmlElement.style.fontSize = sizeMap[size];\n    \n    trackAnalytics({\n      name: 'font_size_changed',\n      category: 'accessibility',\n      data: { size }\n    });\n  }, []);\n\n  // High contrast mode toggle\n  const toggleHighContrast = useCallback(() => {\n    setState(prev => {\n      const newMode = !prev.highContrastMode;\n      document.documentElement.classList.toggle('high-contrast', newMode);\n      \n      trackAnalytics({\n        name: 'high_contrast_toggled',\n        category: 'accessibility',\n        data: { enabled: newMode }\n      });\n      \n      return { ...prev, highContrastMode: newMode };\n    });\n  }, []);\n\n  // Healthcare-specific accessibility helpers\n  const announceHealthcareError = useCallback((error: string, context?: string) => {\n    const message = context \n      ? `Healthcare data error in ${context}: ${error}`\n      : `Healthcare data error: ${error}`;\n    \n    announce(message, 'assertive');\n  }, [announce]);\n\n  const announceFileProcessingStatus = useCallback((status: 'started' | 'completed' | 'failed', fileName?: string) => {\n    const messages = {\n      started: `File processing started${fileName ? ` for ${fileName}` : ''}`,\n      completed: `File processing completed successfully${fileName ? ` for ${fileName}` : ''}`,\n      failed: `File processing failed${fileName ? ` for ${fileName}` : ''}. Please check your file and try again.`\n    };\n    \n    announce(messages[status], status === 'failed' ? 'assertive' : 'polite');\n  }, [announce]);\n\n  // Cleanup\n  useEffect(() => {\n    return () => {\n      if (announcementTimeoutRef.current) {\n        clearTimeout(announcementTimeoutRef.current);\n      }\n    };\n  }, []);\n\n  return {\n    ...state,\n    announce,\n    manageFocusOnRouteChange,\n    createFocusTrap,\n    setFontSize,\n    toggleHighContrast,\n    announceHealthcareError,\n    announceFileProcessingStatus,\n  };\n};\n\n// Utility hook for skip links\nexport const useSkipLinks = () => {\n  const skipToContent = useCallback(() => {\n    const mainContent = document.querySelector('main, [role=\"main\"]') as HTMLElement;\n    if (mainContent) {\n      mainContent.focus();\n      mainContent.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n  }, []);\n\n  const skipToNavigation = useCallback(() => {\n    const navigation = document.querySelector('nav, [role=\"navigation\"]') as HTMLElement;\n    if (navigation) {\n      navigation.focus();\n      navigation.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n  }, []);\n\n  return {\n    skipToContent,\n    skipToNavigation,\n  };\n};